# --- Pick ONE way to connect to Ultrahuman ---

# Option A (easiest): personal API token from https://vision.ultrahuman.com/developer-docs
ULTRAHUMAN_API_TOKEN=

# Option B: OAuth app (Partner API). Leave ULTRAHUMAN_API_TOKEN empty to use this.
ULTRAHUMAN_CLIENT_ID=
ULTRAHUMAN_CLIENT_SECRET=
# Where the login is saved. Usually you can leave this out: on Railway it goes on the
# attached volume by itself, elsewhere it goes in ./data/tokens.json
# TOKEN_FILE=/data/tokens.json

# --- Always needed for the hosted version ---

# A long random password. Your AI app sends this so nobody else can read your data.
# Make one with: openssl rand -hex 32
MCP_API_KEY=

# Your timezone, so "today" means your today.
TZ=Asia/Kolkata

# Only needed outside Railway (Railway fills this in by itself)
# PUBLIC_URL=https://your-domain.com
